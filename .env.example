# App
NEXT_PUBLIC_URL=http://localhost:3000
NODE_ENV=development

# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-project.convex.cloud

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Stripe Payments
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
STRIPE_PRICE_ID=price_xxxxx

# Uploadthing (Image uploads)
UPLOADTHING_TOKEN=xxxxx

# Map APIs
NEXT_PUBLIC_OPENAIP_API_KEY=xxxxx
OPENWEATHERMAP_API_KEY=xxxxx

# Aviation Weather
AVWX_TOKEN=xxxxx

# Admin (Google ID that has admin access)
ADMIN_GOOGLE_ID=

# Resend (Email notifications)
RESEND_API_KEY=re_xxxxx

# Internal bot API auth
BOT_API_SECRET=change_me

# PostHog Analytics (optional - only tracks in production)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
